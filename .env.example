# ==========================================
# 讯飞开放平台密钥（从控制台获取）
# ==========================================
IFLYTEK_APP_ID=your_app_id
IFLYTEK_API_KEY=your_api_key
IFLYTEK_API_SECRET=your_api_secret

# ==========================================
# 转写参数（可选）
# ==========================================
IFLYTEK_LANGUAGE=autodialect
# 领域参数：court/finance/medical/tech/sport/edu/isp/gov/game/ecom/mil/com/life/ent/culture/car，留空不传
IFLYTEK_PD=

# 轮询参数（可选）
IFLYTEK_POLL_INTERVAL=10
IFLYTEK_POLL_MAX_WAIT=3600

# ==========================================
# 运行时端口（AgentArts 平台通过 AGENT_RUN_PORT 注入，默认 8080）
# ==========================================
AGENT_RUN_PORT=8080

# 华为云凭证（agentarts launch 部署时需要，也可用 export 配置）
# HUAWEICLOUD_SDK_AK=your-access-key
# HUAWEICLOUD_SDK_SK=your-secret-key
